source: transactions is duckdb.table('data/transactions.csv') extend {
  primary_key: txn_hash

  measure:
    # Fee actually charged. Failed transactions pay too.
    fees is sum(fee_charged)
    txn_count is count()
}

source: operations is duckdb.table('data/operations.csv') extend {
  primary_key: op_id

  // Many operations belong to one transaction.
  join_one: txn is transactions on txn_hash = txn.txn_hash

  measure:
    op_count is count()
    # Same fee, computed from the operations side by spreading it across rows.
    fees_divided is sum(fee_charged / txn_op_count)
}

// ---------- Step 3: look at the data ----------

run: operations -> {
  select: *
}

// ---------- Step 4: the wrong answer (3200) ----------

run: operations -> {
  aggregate: wrong_total is sum(fee_charged)
}

// ---------- Step 5: the right answer from the measure (1100) ----------

run: operations -> {
  aggregate: fees_divided, op_count
}

// ---------- Step 6: slice it and it stays right ----------

run: operations -> {
  group_by: txn.successful
  aggregate: fees_divided, op_count
}

// ---------- Step 7: the join does it with no division at all (1100) ----------

run: operations -> {
  group_by: txn.successful
  aggregate: op_count, txn.fees, txn.txn_count
}
